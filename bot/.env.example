# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=
# رقم حسابك على تلجرام (بعد ما يشتغل البوت ابعتله /myid وبيعطيك إياه)
OWNER_TELEGRAM_ID=
# شغّل الواتس؟ 1 = آه، 0 = لا
ENABLE_WHATSAPP=1
# كمان ابعتلي ملخص الطلبات على الواتس (رسائل لنفسي)؟ 1 = آه
NOTIFY_OWNER_ON_WHATSAPP=1
# قديش ساعة البوت يسكت بالمحادثة لما انت ترد بإيدك أو لما يحوّل الزبون إلك
PAUSE_HOURS=12
# وين تنحفظ البيانات (حالة المحادثات وجلسة الواتس)
DATA_DIR=./data
# إذا البوت على سيرفر وما بتقدر تمسح QR: حط رقم الواتس هون (مع رمز الدولة، مثلاً 970591234567)
# وبيطلعلك كود من 8 حروف بتدخله بواتساب ← الأجهزة المرتبطة ← الربط برقم الهاتف
WA_PAIR_PHONE=
